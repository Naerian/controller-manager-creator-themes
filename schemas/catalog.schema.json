{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controller Manager creator-theme catalog",
  "type": "object",
  "required": ["SchemaVersion", "Themes"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "GeneratedUtc": { "type": "string" },
    "Themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["Id", "Versions"],
        "properties": {
          "Id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
          "Versions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["Version", "SchemaVersion", "MinimumPluginVersion", "Url", "Sha256", "Size"],
              "properties": {
                "Version": { "type": "string" },
                "SchemaVersion": { "const": 1 },
                "MinimumPluginVersion": { "type": "string" },
                "MaximumPluginVersion": { "type": ["string", "null"] },
                "Url": { "type": "string", "pattern": "^https://" },
                "Sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
                "Size": { "type": "integer", "minimum": 1, "maximum": 33554432 }
              }
            }
          }
        }
      }
    }
  }
}
